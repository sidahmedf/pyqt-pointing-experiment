g_participants <- ggplot(data = data, aes(x = User, y = Time_ms, fill = User)) +
geom_boxplot() +
scale_fill_brewer(palette = "Set2") +
theme_minimal()
# 2. Ajustement des axes et du style (ici, on cache la légende redondante)
g_participants <- g_participants +
theme(legend.position = "none")
