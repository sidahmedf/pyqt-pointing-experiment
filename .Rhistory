## Initialisation des données
```{r init-data, message=FALSE, warning=FALSE}
# 1. Charger la librairie (tidyverse inclut dplyr et ggplot2)
library(tidyverse)
# 2. Charger le jeu de données
data <- read.csv2("data.csv", sep=",", dec=".")
# 3. Afficher un résumé pour vérifier que tout est bien chargé
summary(data)
### Marquez les colonnes adéquates comme des facteurs
```{r}
data$User = factor(data$User)
data$Technique = factor(data$Technique)
data$Size = factor(data$Size)
data$Repetition = factor(data$Repetition)
data$Target_ID = factor(data$Target_ID)
summary(data)
## Vérifiez que les données sont correctes, c'est-à-dire que le nombre de lignes de données correspond bien au nombre attendu, que chaque facteur ait le même nompre de points de données, etc.
done
## Filtrez les lignes pour pour ne garder que celles où l'utilisateur n'a pas fait d'erreur, ainsi que les colonnes qui ne vous serviront plus.
```{r}
data <- data %>%
filter(as.numeric(Errors)==0) %>%
select(!c(Target_ID,Timestamp,Errors))
summary(data)
summary(data)
summary(data)
# 2. Charger le jeu de données
data <- read.csv2("data.csv", sep=",", dec=".")
# 3. Afficher un résumé pour vérifier que tout est bien chargé
summary(data)
data$User = factor(data$User)
data$Technique = factor(data$Technique)
data$Density = factor(data$Density)
data$Size = factor(data$Size)
data$Repetition = factor(data$Repetition)
data$Target_ID = factor(data$Target_ID)
summary(data)
data$Density = factor(data$Density, levels = c("30", "60", "90"))
summary(data)
data$Density = factor(data$Density)
summary(data)
nrow(data)
summary(data)
# Total rows
nrow(data)  # what do you expect ? 5040 ? tell me your experiment design
# Balance check per factor
table(data$User)        # should be equal across all users
table(data$Technique)   # should be equal
table(data$Density)     # should be equal
table(data$Size)        # should be equal
table(data$Repetition)  # should be equal
# Cross-check: each user did each technique the same number of times
table(data$User, data$Technique)
# Total rows
nrow(data)  # what do you expect ? 5040 ? tell me your experiment design
# Balance check per factor
table(data$User)        # should be equal across all users
table(data$Technique)   # should be equal
table(data$Density)     # should be equal
table(data$Size)        # should be equal
table(data$Repetition)  # should be equal
# Cross-check: each user did each technique the same number of times
table(data$User, data$Technique)
# This will throw an error if something is wrong, silent if ok
stopifnot(nrow(data) == 5040)  # replace 5040 with your expected number
stopifnot(all(table(data$User) == 720))
## Filtrez les lignes pour pour ne garder que celles où l'utilisateur n'a pas fait d'erreur, ainsi que les colonnes qui ne vous serviront plus.
nrow_before <- nrow(data)
data <- data %>%
filter(as.numeric(Errors)==0) %>%
select(!c(Target_ID,Timestamp,Errors))
nrow_after <- nrow(data)
cat("Lignes avant filtrage :", nrow_before, "\n")
cat("Lignes après filtrage :", nrow_after, "\n")
cat("Lignes supprimées (erreurs) :", nrow_before - nrow_after, "\n")
cat("Taux d'erreur :", round((nrow_before - nrow_after) / nrow_before * 100, 1), "%\n")
summary(data)
knitr::opts_chunk$set(echo = TRUE)
# 1. Charger la librairie (tidyverse inclut dplyr et ggplot2)
library(tidyverse)
# 2. Charger le jeu de données
data <- read.csv2("data.csv", sep=",", dec=".")
# 3. Afficher un résumé pour vérifier que tout est bien chargé
summary(data)
data$User = factor(data$User)
data$Technique = factor(data$Technique)
data$Density = factor(data$Density)
data$Size = factor(data$Size)
data$Repetition = factor(data$Repetition)
data$Target_ID = factor(data$Target_ID)
summary(data)
nrow(data)
